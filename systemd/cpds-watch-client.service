[Unit]
Description=CPDS-AI Watch Client (Camera & Mic)
After=cpds-inference-server.service
Requires=cpds-inference-server.service

[Service]
Type=simple
ExecStart=/bin/bash -c "source .venv/bin/activate && python3 -m src.daemon.client"
WorkingDirectory=/media/trtrung1209/WORKSPACES/WORKSPACES/01_PROJECTS/2026_NCKH_CPDS-AI
Restart=on-failure
RestartSec=5s
Environment="CPDS_SOCKET_PATH=/tmp/cpds_inference.sock"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
